---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Navbar from "../../components/Navbar.astro";
import ExercisePanel from "../../components/exercises/ExercisePanel";
import { getCollection } from "astro:content";
import { buildIdMap } from "../../lib/exercises/idMap";

export async function getStaticPaths() {
  const exercises = (await getCollection("exercises")).filter((e) => !e.data.draft);
  return exercises.map((e) => ({ params: { slug: e.slug }, props: { exercise: e } }));
}

const { exercise } = Astro.props;
const { Content } = await exercise.render();

// ex_srs/ex_off can reference other exercises, not just this one, so the full
// collection is needed here to build a complete id<->slug translation table.
const allExercises = (await getCollection("exercises")).filter((e) => !e.data.draft);
const idMap = buildIdMap(allExercises);
---

<BaseLayout
  title={exercise.data.title}
  ogTitle={exercise.data.title}
  ogDescription={exercise.data.description}
  ogImage={exercise.data.image.thumbSrc || exercise.data.image.src}
  ogType="article"
>
  <Navbar currentPath={Astro.url.pathname} />
  <main class="mx-auto max-w-3xl px-4 py-10">
    <nav class="mb-8">
      <a
        href="/exercises"
        class="text-sm text-neutral-600 transition-colors hover:text-[#7467ff] dark:text-neutral-400 dark:hover:text-[#7467ff]"
      >
        ← Back to Exercises
      </a>
    </nav>

    <header class="mb-6">
      <h1 class="text-xl font-semibold">{exercise.data.title}</h1>
    </header>

    <figure class="mb-6 overflow-hidden rounded-xl border border-neutral-200 dark:border-neutral-800">
      <img
        src={exercise.data.image.src}
        alt={exercise.data.image.alt}
        width={exercise.data.image.width}
        height={exercise.data.image.height}
        class="h-auto w-full"
      />
    </figure>

    <article
      class="prose prose-neutral max-w-none dark:prose-invert prose-headings:font-semibold prose-a:text-[#7467ff] prose-a:no-underline hover:prose-a:underline dark:prose-a:text-[#7467ff]"
    >
      <Content />
    </article>

    <div class="mt-10 border-t border-neutral-200 pt-8 dark:border-neutral-800">
      <ExercisePanel slug={exercise.slug} idMap={idMap} client:load />
    </div>
  </main>
</BaseLayout>
